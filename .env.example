# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Database (required) ---
# Local MongoDB (single-node REPLICA SET — recommended so credit transactions
# are fully atomic). Start one with:
#   mongod --replSet rs0 --dbpath ./data
#   mongosh --eval "rs.initiate()"
# then use this URI:
MONGODB_URI=mongodb://127.0.0.1:27017/smm-panel?replicaSet=rs0
# Plain standalone MongoDB also works: the app auto-detects it, disables
# retryable writes and runs credit operations without session atomicity
# (a warning is logged once). Use a replica set in production.
# MONGODB_URI=mongodb://127.0.0.1:27017/smm-panel
# MongoDB Atlas example (URL-encode special characters in the password):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smm-panel?retryWrites=true&w=majority

# --- Auth (REQUIRED in all environments; strong random in production) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# (96 hex chars). Must be at least 32 characters. In production a placeholder,
# password-like, or JWT-header-like value is rejected at boot.
# NEVER expose via NEXT_PUBLIC_* — server-only. There is NO insecure fallback —
# the app refuses to sign/verify sessions without this.
JWT_SECRET=

# --- Admin bootstrap (REQUIRED) ---
# The ONLY account bootstrap remaining. The first admin account is created ONLY
# from these two variables — there are no demo or fallback accounts anymore.
# ADMIN_PASSWORD is SERVER-ONLY, ≥8 chars. There is no hardcoded default
# credential — seeding fails loudly without them.
ADMIN_EMAIL=admin@yourpanel.com
ADMIN_PASSWORD=

# --- Reverse proxy / rate limiting / CSRF ---
# Only set to "true" if this app sits behind exactly one trusted reverse
# proxy (Vercel, Nginx, Cloudflare, etc.) that appends the real client IP as
# the LAST entry of X-Forwarded-For, and that sets X-Forwarded-Host/Proto
# honestly. Leave unset/false otherwise — trusting an unverified
# X-Forwarded-For lets clients spoof their IP and bypass rate limits.
TRUST_PROXY=false

# Used for verification/reset email links and as an extra trusted origin for
# the CSRF same-origin check when the public URL differs from what the
# server sees internally.
FRONTEND_URL=http://localhost:3000

# --- Razorpay (OPTIONAL overall; REQUIRED for live payments in production) ---
# RAZORPAY_KEY_ID may additionally be exposed as NEXT_PUBLIC_RAZORPAY_KEY_ID
# (publishable only). RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET are
# SERVER-ONLY and must never use a NEXT_PUBLIC_ name. In production, when
# Razorpay keys are set, RAZORPAY_WEBHOOK_SECRET must be set explicitly (no
# silent fallback to the key secret). Demo checkout runs only in non-production
# when keys are unset.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Google OAuth (optional — "Continue with Google" is hidden/errors without it) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- SMTP email (OPTIONAL — REQUIRED for real email in production) ---
# Verification/password-reset links are logged/returned without SMTP in dev.
# All SMTP_* are SERVER-ONLY; never expose via NEXT_PUBLIC_*.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- SMM provider (OPTIONAL overall; REQUIRED for live boosts/status in production) ---
# Base URL of the provider's single-endpoint RPC API. Defaults to
# https://ethicalsmm.com/api/v2 when unset — override for white-label providers.
# (Not a secret; MAY be public.)
SMM_API_URL=https://ethicalsmm.com/api/v2
# Your provider API key (the `key` parameter). REQUIRED for scheduling boosts,
# live order status and balance checks. SERVER-ONLY — never NEXT_PUBLIC_*.
# Never hardcode it — this file is the
# only place it should appear outside your secret manager.
SMM_API_KEY=
# Dedicated secret used to encrypt connected social-account OAuth tokens at
# rest (AES-256-GCM). REQUIRED in production — must NOT fall back to JWT_SECRET
# there (dev-only fallback otherwise). SERVER-ONLY. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCOUNT_ENCRYPTION_KEY=
# Shared secret for the POST /api/posts/process cron worker endpoint
# (sent as the `x-cron-secret` header). REQUIRED in production for external
# cron access (admin sessions also work). SERVER-ONLY, ≥32 chars in prod.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- Ops ---
# Optional bearer secret for a verbose /api/health payload (latency, seed
# status). Without it, /api/health only ever returns {"ok": true|false}.
HEALTH_SECRET=

NODE_ENV=development
